{
  "name": "octo-agent",
  "version": "1.0.0",
  "description": "Octo Agent — 3D Autonomous Multi-Agent Workforce, Virtual Office & Containerized Runtime",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "npm run dev:3d",
    "dev:3d": "npm run --prefix packages/octo-3d dev",
    "dev:office": "npm run --prefix packages/octo-office dev",
    "dev:core": "npm run --prefix packages/octo-core dev",
    "dev:demo": "npm run --prefix packages/octo-3d demo-gateway",
    "build": "npm run --prefix packages/octo-3d build && npm run --prefix packages/octo-office build",
    "build:core": "npm run --prefix packages/octo-core build",
    "build:3d": "npm run --prefix packages/octo-3d build",
    "build:office": "npm run --prefix packages/octo-office build",
    "octo": "npm run --prefix packages/octo-core octo --",
    "test": "npm run --prefix packages/octo-core test",
    "mascot": "node scripts/serve-mascot.js"
  },
  "keywords": [
    "octo-agent",
    "ai-agents",
    "3d-office",
    "threejs",
    "virtual-office",
    "multi-agent",
    "autonomous-workforce",
    "nanoclaw",
    "claw3d",
    "openclaw"
  ],
  "author": "Octo Agent Team",
  "license": "MIT"
}
