{
  "name": "octo-agent",
  "version": "1.0.0",
  "description": "Octo Agent — Autonomous AI Agents Connected to 3D Model Creation & Spatial 3D Workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "npm run dev:3d",
    "dev:3d": "npm run --prefix packages/octo-3d dev",
    "dev:core": "npm run --prefix packages/octo-core dev",
    "dev:demo": "npm run --prefix packages/octo-3d demo-gateway",
    "build": "npm run --prefix packages/octo-3d build",
    "build:core": "npm run --prefix packages/octo-core build",
    "build:3d": "npm run --prefix packages/octo-3d build",
    "octo": "npm run --prefix packages/octo-core octo --",
    "test": "npm run --prefix packages/octo-core test",
    "mascot": "node scripts/serve-mascot.js"
  },
  "keywords": [
    "octo-agent",
    "ai-agents",
    "3d-model-creation",
    "prompt-to-3d",
    "procedural-3d",
    "threejs",
    "webgl",
    "virtual-workspace",
    "multi-agent",
    "autonomous-workforce",
    "octo-core",
    "octo-3d",
    "octo-mascot"
  ],
  "author": "Octo Agent Team",
  "license": "MIT"
}
